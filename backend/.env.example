# Server
NODE_ENV=development
PORT=5000

# Client URL (used for CORS and cookie settings)
CLIENT_URL=http://localhost:5173

# MongoDB
# Local development example:
MONGO_URI=mongodb://127.0.0.1:27017/peptide_store
# MongoDB Atlas production example:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/peptide_store?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# Admin bootstrap (used only by the seed script to create the first admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_NAME=Store Admin

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200
